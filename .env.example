ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# qdrant or pgvector
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Needed when VECTOR_STORE=pgvector
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ai_os
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_os

# Needed for inventory text-to-SQL; role with SELECT on units only
INVENTORY_READ_ONLY_DATABASE_URL=postgresql+asyncpg://inventory_reader:password@localhost:5432/ai_os

WHISPER_MODEL=large-v3
# Optional: speaker labels on transcripts (accept the pyannote model terms on Hugging Face first)
HUGGING_FACE_TOKEN=
# Required. The API stays closed without AUTH_SECRET (at least 32 characters),
# and CRM webhooks without CRM_WEBHOOK_SECRET.
AUTH_SECRET=
CRM_WEBHOOK_SECRET=

# Optional: spoken buyer lines in role-play
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

BUSINESS_TIMEZONE=Africa/Cairo
# Optional: written by scripts/train_best_time.py
BEST_TIME_MODEL_PATH=models/best_time.txt

BUSINESS_TIMEZONE=Africa/Cairo
# Optional: written by scripts/train_best_time.py
BEST_TIME_MODEL_PATH=models/best_time.txt

# Optional tracing. Prompts stay out of traces unless capture is on.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false

TEMPORAL_ADDRESS=localhost:7233
