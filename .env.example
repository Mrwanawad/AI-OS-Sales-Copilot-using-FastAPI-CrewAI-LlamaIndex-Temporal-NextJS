ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# qdrant or pgvector
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Needed when VECTOR_STORE=pgvector
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ai_os
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_os

# Needed for inventory text-to-SQL; role with SELECT on units only
INVENTORY_READ_ONLY_DATABASE_URL=postgresql+asyncpg://inventory_reader:password@localhost:5432/ai_os

WHISPER_MODEL=large-v3
# Optional: speaker labels on transcripts (accept the pyannote model terms on Hugging Face first)
HUGGING_FACE_TOKEN=
# Required. The API stays closed without AUTH_SECRET (at least 32 characters),
# and CRM webhooks without CRM_WEBHOOK_SECRET.
AUTH_SECRET=
CRM_WEBHOOK_SECRET=
# While rotating AUTH_SECRET, put the old value here until its tokens expire (8 hours).
AUTH_PREVIOUS_SECRET=
AUTH_TOKEN_HOURS=8

# The web app's URL: allowed by CORS and used in notification links.
APP_URL=http://localhost:3000
# Extra comma-separated origins, e.g. Vercel preview URLs
CORS_ORIGINS=

# Optional: escalation tickets are POSTed here (n8n, Zapier, a WhatsApp gateway),
# signed with HMAC-SHA256 over "<X-Timestamp>.<body>". Without a URL they only queue.
ESCALATION_WEBHOOK_URL=
ESCALATION_WEBHOOK_SECRET=
# Days an approved answer stays in search before a team lead must renew it.
APPROVED_ANSWER_VALID_DAYS=90
# Egypt PDPL retention in days. Placeholders: the brokerage's legal team sets these.
INTERACTION_CONTENT_RETENTION_DAYS=730
DORMANT_CARD_RETENTION_DAYS=365
CLOSED_TICKET_RETENTION_DAYS=365

# Optional: creates demo logins (rep-a, rep-b, lead-a, manager-a) in scripts/seed_demo.py
DEMO_PASSWORD=

# Optional: spoken buyer lines in role-play
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

BUSINESS_TIMEZONE=Africa/Cairo
# Placeholders until the brokerage sets its policy: calling hours (local time) and days
# (Monday = 0), and the discount each role may approve without escalation.
CALL_WINDOW_FIRST_HOUR=9
CALL_WINDOW_LAST_HOUR=21
CALL_WINDOW_DAYS=0,1,2,3,4,5,6
DISCOUNT_LIMIT_REP_PCT=2
DISCOUNT_LIMIT_TEAM_LEAD_PCT=5
DISCOUNT_LIMIT_MANAGER_PCT=10
# Optional: written by scripts/train_best_time.py
BEST_TIME_MODEL_PATH=models/best_time.txt

# Optional tracing. Prompts stay out of traces unless capture is on.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false

TEMPORAL_ADDRESS=localhost:7233
